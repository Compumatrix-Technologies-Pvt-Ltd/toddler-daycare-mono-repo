{
  "name": "@repo/config",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/react-native.json": "./tsconfig/react-native.json",
    "./env": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "eslint",
    "prettier",
    "tsconfig",
    "env"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.env.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc -p tsconfig.env.json --watch"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": ">=7.0.0",
    "@typescript-eslint/parser": ">=7.0.0",
    "eslint": ">=8.0.0",
    "eslint-plugin-react": ">=7.0.0",
    "eslint-plugin-react-hooks": ">=4.0.0",
    "prettier": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/eslint-plugin": { "optional": true },
    "@typescript-eslint/parser": { "optional": true },
    "eslint": { "optional": true },
    "eslint-plugin-react": { "optional": true },
    "eslint-plugin-react-hooks": { "optional": true },
    "prettier": { "optional": true }
  }
