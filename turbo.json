{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "PORT",
        "MONGODB_URI",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SOCKET_URL",
        "VITE_API_URL",
        "VITE_SOCKET_URL",
        "EXPO_PUBLIC_API_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "MONGODB_URI",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SOCKET_URL",
        "VITE_API_URL",
        "VITE_SOCKET_URL",
        "EXPO_PUBLIC_API_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
